# Team Report 生产配置（由 install.sh 写入 /etc/team-report/config.env）
PORT=3000
NODE_ENV=production
SERVE_STATIC=true

# 安装脚本会根据路径写入绝对路径
# INSTALL_DIR=/opt/team-report
# STATIC_DIR=/opt/team-report/app/frontend/dist
# DB_PATH=/var/lib/team-report/data/teamplan.db

# 首次安装时自动生成，请勿泄露；升级安装不会覆盖已有值
JWT_SECRET=

# 可选：关闭公开注册
# PUBLIC_REGISTRATION=false

# 可选：AI（也可在管理后台配置）
# AI_API_KEY=
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=   # 通义千问
# MOONSHOT_API_KEY=    # Kimi
# ZHIPU_API_KEY=       # 智谱 GLM
