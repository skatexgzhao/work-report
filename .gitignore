# Never pack or commit local Git metadata (not pushed by git push, but block zip/manual copies)
.git/

# Dependencies
node_modules/

# Build output
dist/
frontend/dist/

# Secrets & local env (never commit real values)
.env
.env.*
!.env.example
deploy/config.env

# Keys & credentials
*.pem
*.key
*.p12
*.pfx
credentials.json
**/secrets.json

# Runtime data
*.log
teamplan.db
backend/teamplan.db
backend/teamplan.db-*
backend/test/*.db
*.sqlite
*.sqlite3

# Local tooling
.dev/
.worktrees/

# OS junk
.DS_Store
Thumbs.db

# Test / coverage
coverage/

# Cursor / Comet / OpenSpec / internal design (not for public GitHub export)
.cursor/
.comet/
openspec/
COMET.md
docs/superpowers/

# OpenSpec change handoff temp (regenerated by scripts)
openspec/changes/*/.comet/handoff/
